# --- Existing variables from root .env ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
MINIO_BUCKET=lake

CAMERA_INDEX=0
CAMERA_ID=webcam0

EMIT_EVERY_SEC=5
SESSION_GAP_SEC=2

CONF_THRES=0.35
INFER_EVERY_N=1
SNAPSHOT_JPEG_QUALITY=85

S3_PREFIX_SNAPSHOTS=raw/vision/person_snapshots
S3_PREFIX_EVENTS=raw/events/person_detection
S3_PREFIX_SESSIONS=raw/vision/presence_sessions

# RabbitMQ settings
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=admin
RABBIT_PASS=admin123
RABBIT_EXCHANGE=vision.alerts
RABBITMQ_ERLANG_COOKIE=mysecretcookie

# CDC Postgres
CDC_POSTGRES_USER=dbz
CDC_POSTGRES_PASSWORD=dbz
CDC_POSTGRES_DB=inventory

# Hive Metastore
HMS_DB_USER=hive
HMS_DB_PASSWORD=hive_password
HMS_DB_NAME=metastore

# Apache Airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin123
AIRFLOW_WEBSERVER_SECRET_KEY=mini-datalake-secret-key-2024

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# --- CDC specific ---
KAFKA_BOOTSTRAP=localhost:9092
CDC_TOPIC=pgserver1.public.customers
